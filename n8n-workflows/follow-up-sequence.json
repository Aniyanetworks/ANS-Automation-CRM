    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// TESTING MODE: shouldSend is always true — time checks are skipped.\n// Remove the TESTING MODE comment and restore the hoursSince check for production.\n\nconst now = new Date();\nconst BOOKING_LINK = 'https://cal.com/manam';\n\nlet settings = [];\ntry {\n  const raw = $('Get Settings').all()[0].json;\n  settings = Array.isArray(raw) ? raw.filter(s => s.is_active) : [];\n} catch(e) {}\n\nlet contacts = [];\ntry {\n  const raw = $input.first().json;\n  contacts = Array.isArray(raw) ? raw : [];\n} catch(e) {}\n\nif (contacts.length === 0 || settings.length === 0) {\n  return [{ json: {\n    shouldSend: false, _dbg_reason: contacts.length === 0 ? 'no_contacts' : 'no_settings'\n  }}];\n}\n\nfunction render(template, vars) {\n  if (!template) return '';\n  return String(template)\n    .replace(/\\{\\{name\\}\\}/g,         vars.name)\n    .replace(/\\{\\{service\\}\\}/g,      vars.service)\n    .replace(/\\{\\{booking_link\\}\\}/g, vars.booking_link);\n}\n\nconst results = [];\n\nfor (const d of contacts) {\n  try {\n    const currentStep = typeof d.followup_step === 'number' ? d.followup_step : 0;\n    const nextStepNum  = currentStep + 1;\n    const nextConfig   = settings.find(s => s.step_number === nextStepNum);\n\n    if (!nextConfig) {\n      // All steps completed for this contact\n      continue;\n    }\n\n    const refStr     = d.last_followup_date || d.last_action_date || d.created_at;\n    const refDate    = refStr ? new Date(refStr) : new Date('2000-01-01');\n    const hoursSince = (now - refDate) / 3_600_000;\n\n    // TESTING MODE: skip time check — always send\n    // PRODUCTION: uncomment the block below and remove this line\n    // if (hoursSince < nextConfig.wait_hours) { results.push({ json: { id: d.id, name: d.name, shouldSend: false, _dbg_reason: 'not_due_yet', _dbg_waitHours: nextConfig.wait_hours, _dbg_hoursSince: Math.round(hoursSince * 100) / 100 }}); continue; }\n\n    const firstName = d.name ? d.name.split(' ')[0] : 'there';\n    const service   = d.message || d.service_type || d.interest || 'your request';\n    const vars      = { name: firstName, service, booking_link: BOOKING_LINK };\n\n    const hasSMS   = nextConfig.sms_enabled  && !!(d.phone && String(d.phone).trim());\n    const hasEmail = nextConfig.email_enabled && !!(d.email && String(d.email).trim());\n\n    results.push({ json: {\n      ...d,\n      shouldSend:   true,\n      nextStepNum,\n      stepLabel:    nextConfig.label,\n      smsPhone:     hasSMS  ? String(d.phone).trim() : '',\n      emailTo:      hasEmail ? String(d.email).trim() : '',\n      smsText:      hasSMS  ? render(nextConfig.sms_template,   vars) : '',\n      emailSubject: hasEmail ? render(nextConfig.email_subject,  vars) : '',\n      emailText:    hasEmail ? render(nextConfig.email_template, vars) : '',\n      nowISO:       now.toISOString(),\n      _dbg_hoursSince: Math.round(hoursSince * 100) / 100\n    }});\n  } catch(e) {\n    results.push({ json: {\n      id: d.id || '', name: d.name || '',\n      shouldSend: false, _dbg_error: String(e)\n    }});\n  }\n}\n\nreturn results.length > 0\n  ? results\n  : [{ json: { shouldSend: false, _dbg_reason: 'no_actions_due' } }];"
      },

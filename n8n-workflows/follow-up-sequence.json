    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// TESTING MODE: time check is disabled — every contact with a next step gets sent.\n// For production: uncomment the hoursSince block and restore real wait times in Settings.\n\nconst now = new Date();\nconst BOOKING_LINK = 'https://cal.com/manam';\n\nlet settings = [];\ntry {\n  const allSettings = $('Get Settings').all();\n  const firstSetting = allSettings[0].json;\n  const settingsArr = Array.isArray(firstSetting) ? firstSetting : allSettings.map(i => i.json);\n  settings = settingsArr.filter(s => s.is_active);\n} catch(e) {}\n\nlet contacts = [];\ntry {\n  const allItems = $input.all();\n  const firstJson = allItems[0].json;\n  contacts = Array.isArray(firstJson) ? firstJson : allItems.map(i => i.json);\n} catch(e) {}\n\nif (contacts.length === 0 || settings.length === 0) {\n  return [{ json: { shouldSend: false, _dbg_reason: contacts.length === 0 ? 'no_contacts' : 'no_settings' } }];\n}\n\nfunction render(template, vars) {\n  if (!template) return '';\n  return String(template)\n    .replace(/\\{\\{name\\}\\}/g,         vars.name)\n    .replace(/\\{\\{service\\}\\}/g,      vars.service)\n    .replace(/\\{\\{booking_link\\}\\}/g, vars.booking_link);\n}\n\nconst results = [];\n\nfor (const d of contacts) {\n  try {\n    const currentStep = typeof d.followup_step === 'number' ? d.followup_step : 0;\n    const nextStepNum = currentStep + 1;\n    const nextConfig  = settings.find(s => s.step_number === nextStepNum);\n\n    if (!nextConfig) continue; // all steps done for this contact\n\n    const refStr     = d.last_followup_date || d.last_action_date || d.created_at;\n    const refDate    = refStr ? new Date(refStr) : new Date('2000-01-01');\n    const hoursSince = (now - refDate) / 3_600_000;\n\n    // TESTING MODE: always send — no time check\n    // PRODUCTION: uncomment below\n    // if (hoursSince < nextConfig.wait_hours) continue;\n\n    const firstName = d.name ? d.name.split(' ')[0] : 'there';\n    const service   = d.message || d.service_type || d.interest || 'your request';\n    const vars      = { name: firstName, service, booking_link: BOOKING_LINK };\n\n    const hasSMS   = nextConfig.sms_enabled   && !!(d.phone  && String(d.phone).trim());\n    const hasEmail = nextConfig.email_enabled  && !!(d.email  && String(d.email).trim());\n\n    results.push({ json: {\n      ...d,\n      shouldSend:   true,\n      nextStepNum,\n      stepLabel:    nextConfig.label,\n      smsPhone:     hasSMS  ? String(d.phone).trim()  : '',\n      emailTo:      hasEmail ? String(d.email).trim() : '',\n      smsText:      hasSMS  ? render(nextConfig.sms_template,  vars) : '',\n      emailSubject: hasEmail ? render(nextConfig.email_subject, vars) : '',\n      emailText:    hasEmail ? render(nextConfig.email_template, vars) : '',\n      nowISO:       now.toISOString(),\n      _dbg_hoursSince: Math.round(hoursSince * 100) / 100\n    }});\n  } catch(e) {\n    results.push({ json: { id: d.id || '', name: d.name || '', shouldSend: false, _dbg_error: String(e) } });\n  }\n}\n\nreturn results.length > 0\n  ? results\n  : [{ json: { shouldSend: false, _dbg_reason: 'no_actions_due' } }];"
      },

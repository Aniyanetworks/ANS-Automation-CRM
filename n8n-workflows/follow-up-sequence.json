      "id": "6e2f1006-8038-4db8-9e9d-da9fa007cba1",
      "name": "Get Eligible Contacts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-192, 672],
      "credentials": {
        "httpHeaderAuth": { "id": "SehDVTutwS7XzjTn", "name": "Supabase ANS CRM" }

    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const client = $json;\nconst campaigns = $('Get Nurture Campaigns').all().map(i => i.json);\nconst campaign = campaigns.find(c => c.id === client.campaign_id);\nconst now = new Date();\n// Campaign paused/missing -> skip (do not send, do not reschedule).\nif (!campaign) { return { ...client, shouldSend: false, client_id: client.id, nowISO: now.toISOString() }; }\nconst interval = Number(campaign.interval_days) || 30;\n// TESTING: reschedule 10 minutes out. PRODUCTION: new Date(now.getTime() + interval * 86400000)\nconst nextSendAt = new Date(now.getTime() + 10 * 60000).toISOString();\nconst firstName = (client.name || 'there').split(' ')[0];\nreturn {\n  ...client,\n  shouldSend: true,\n  client_id: client.id,\n  email: client.email,\n  name: client.name || '',\n  firstName,\n  note: client.note || '',\n  tone: campaign.ai_reply_prompt || 'Write a warm, friendly relationship check-in to a past client. Not a sales pitch.',\n  fromName: campaign.from_name || '',\n  subject: 'Hi ' + firstName + ', just checking in',\n  nextSendAt,\n  emailsSent: (Number(client.emails_sent) || 0) + 1,\n  nowISO: now.toISOString()\n};"
      },

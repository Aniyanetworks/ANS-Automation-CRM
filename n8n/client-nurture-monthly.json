    {
      "parameters": {
        "jsCode": "// Works whether Get Due Clients returns the array wrapped in one item's json,\n// or split into one item per row. Emits every due client as its own item.\nconst out = [];\nfor (const it of $input.all()) {\n  const v = it.json;\n  if (Array.isArray(v)) { for (const c of v) out.push({ json: c }); }\n  else if (v && (v.id || v.email)) { out.push({ json: v }); }\n}\nreturn out;"
      },
      "id": "e1f2a3b4-0004-4e04-9e04-000000000004",
      "name": "Split Clients",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1984,
        848
      ]
    },
    {
      "parameters": {
        "jsCode": "const campaigns = $('Get Nurture Campaigns').all().map(i => i.json);\nconst sentToday = $('Get Sent Today').all().map(i => i.json);\nconst now = new Date();\nconst weekday = $now.weekday; // Luxon 1=Mon..7=Sun (workflow timezone)\nconst hour = $now.hour;\nconst capacity = {};\nfor (const c of campaigns) {\n  const used = sentToday.filter(s => s.campaign_id === c.id).length;\n  const limit = c.daily_limit == null ? 999999 : Number(c.daily_limit);\n  capacity[c.id] = Math.max(0, limit - used);\n}\nconst dayAllowed = (c) => String(c.send_days == null ? '1,2,3,4,5,6,7' : c.send_days).split(',').map(x => parseInt(x.trim(), 10)).includes(weekday);\nconst windowOpen = (c) => { const s = c.send_start_hour == null ? 0 : Number(c.send_start_hour); const e = c.send_end_hour == null ? 24 : Number(c.send_end_hour); return hour >= s && hour < e; };\nconst unitMs = { minutes: 60000, hours: 3600000, days: 86400000 };\nconst items = $input.all();\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const client = items[i].json;\n  const pair = { item: i };\n  const campaign = campaigns.find(c => c.id === client.campaign_id);\n  const base = { ...client, client_id: client.id, nowISO: now.toISOString(), shouldSend: false };\n  if (!campaign) { out.push({ json: base, pairedItem: pair }); continue; }\n  if (!dayAllowed(campaign) || !windowOpen(campaign)) { out.push({ json: base, pairedItem: pair }); continue; }\n  if ((capacity[campaign.id] || 0) <= 0) { out.push({ json: base, pairedItem: pair }); continue; }\n  capacity[campaign.id] -= 1;\n  const interval = Number(campaign.interval_days) || 30;\n  const nextSendAt = new Date(now.getTime() + interval * (unitMs[campaign.interval_unit] || 86400000)).toISOString();\n  const firstName = (client.name || 'there').split(' ')[0];\n  const sent = Number(client.emails_sent) || 0;\n  const subjects = ['Hi ' + firstName + ', just checking in', 'Thinking of you, ' + firstName, firstName + ', how have you been?', 'A quick hello, ' + firstName, 'Just wanted to say hi, ' + firstName];\n  out.push({ json: {\n    ...client, shouldSend: true, client_id: client.id, email: client.email, name: client.name || '', firstName,\n    note: client.note || '', tone: campaign.ai_reply_prompt || 'Write a warm, friendly relationship check-in to a past client. Not a sales pitch.',\n    fromName: campaign.from_name || '', subject: subjects[sent % subjects.length],\n    lastMessage: client.last_message || '', checkInNumber: sent + 1, nextSendAt, emailsSent: sent + 1, nowISO: now.toISOString()\n  }, pairedItem: pair });\n}\nreturn out;"
      },

      "parameters": {
        "jsCode": "// Works whether Find Lead returns the array wrapped in one item's json,\n// or split into one item per row.\nconst items = $input.all();\nlet lead = null;\nfor (const it of items) {\n  const v = it.json;\n  if (Array.isArray(v)) { if (v.length) { lead = v[0]; break; } }\n  else if (v && (v.id || v.email)) { lead = v; break; }\n}\nif (!lead) return [];\nreturn [{ json: lead }];"
      },

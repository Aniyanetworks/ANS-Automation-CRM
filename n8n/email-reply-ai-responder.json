    {
      "parameters": {
        "jsCode": "const rows = [];\nfor (const it of $input.all()) { const v = it.json; if (Array.isArray(v)) { for (const m of v) rows.push(m); } else if (v && v.direction) { rows.push(v); } }\nconst strip = (h) => String(h || '').replace(/<[^>]+>/g, ' ').replace(/&nbsp;/gi, ' ').replace(/&amp;/gi, '&').replace(/[ \\t\\r\\n]+/g, ' ').trim();\nconst lines = rows.map(m => (m.direction === 'inbound' ? 'Client' : 'Us') + ': ' + strip(m.body)).filter(Boolean);\nconst transcript = lines.join(String.fromCharCode(10)) || '(no prior messages)';\nreturn [{ json: { transcript } }];"
      },

      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const m = $json;\nlet fromRaw = m.from || m.From || (m.headers && m.headers.from) || '';\n// Gmail may return 'from' as an object: { value: [{ address, name }], text }\nif (fromRaw && typeof fromRaw === 'object') {\n  if (Array.isArray(fromRaw.value) && fromRaw.value[0] && fromRaw.value[0].address) {\n    fromRaw = fromRaw.value[0].address;\n  } else {\n    fromRaw = fromRaw.text || fromRaw.address || '';\n  }\n}\nfromRaw = String(fromRaw);\nconst match = fromRaw.match(/<([^>]+)>/);\nconst email = (match ? match[1] : fromRaw).trim().toLowerCase();\nconst body = m.text || m.textPlain || m.snippet || '';\nreturn {\n  fromEmail: email,\n  subject: String(m.subject || ''),\n  body: String(body || ''),\n  threadId: m.threadId || '',\n  messageId: m.id || ''\n};"
      },

      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-2432, 848],
      "credentials": {
        "httpHeaderAuth": { "id": "SehDVTutwS7XzjTn", "name": "Supabase ANS CRM" }
      }
    },
    {
      "parameters": {
        "url": "=https://lwzrxstmofibqkxudugc.supabase.co/rest/v1/review_campaigns?id=eq.{{ $json.campaign_id }}&select=name,admin_phone,admin_email,from_name",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer sb_publishable_4uuJGzwYYU8mwoMoEyXe2g_xSwCLuoW" },
            { "name": "Content-Type",  "value": "application/json" },

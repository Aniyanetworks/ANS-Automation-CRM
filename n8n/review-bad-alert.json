      "id": "b1a2d3r4-0003-4b03-9b03-000000000003",
      "name": "Get Campaign Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-2208, 848],
      "credentials": {
        "httpHeaderAuth": { "id": "SehDVTutwS7XzjTn", "name": "Supabase ANS CRM" }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $('Get Unalerted Bad Reviews').item.json;\nconst campaign = $json;\nconst submittedDate = lead.submitted_at\n  ? new Date(lead.submitted_at).toLocaleString('en-CA', { timeZone: 'America/Toronto' })\n  : 'Unknown';\n\nconst smsAlert = `⚠️ BAD REVIEW ALERT\\nCampaign: ${campaign.name || '?'}\\nFrom: ${lead.name || lead.phone || lead.email || 'Unknown'}\\nComment: ${lead.review_comment || '(no comment)'}\\nReceived: ${submittedDate}`;\n\nconst emailBody = `BAD REVIEW RECEIVED\\n\\nCampaign: ${campaign.name || '?'}\\nCustomer: ${lead.name || 'Unknown'}\\nPhone:    ${lead.phone || '—'}\\nEmail:    ${lead.email || '—'}\\nRating:   Bad\\nComment:  ${lead.review_comment || '(no comment)'}\\nReceived: ${submittedDate}\\n\\nPlease follow up with this customer as soon as possible.`;\n\nreturn {\n  ...lead,\n  campaignName: campaign.name || '?',\n  adminPhone: campaign.admin_phone || '',\n  adminEmail: campaign.admin_email || '',\n  smsAlert,\n  emailBody,\n  emailSubject: `⚠️ Bad Review — ${lead.name || lead.email || 'Customer'} (${campaign.name || 'Review Campaign'})`,\n};"
      },
      "id": "b1a2d3r4-0004-4b04-9b04-000000000004",
      "name": "Build Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1984, 848]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            { "value1": "={{ $json.adminPhone }}", "operation": "isNotEmpty" }
          ]
        }
      },
      "id": "b1a2d3r4-0005-4b05-9b05-000000000005",
      "name": "Has Admin Phone?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [-1760, 736]
    },
    {
      "parameters": {
        "resource": "message",
        "to": "={{ $json.adminPhone }}",
        "from": "+1YOUR_TWILIO_NUMBER",
        "body": "={{ $json.smsAlert }}"
      },
      "id": "b1a2d3r4-0006-4b06-9b06-000000000006",
      "name": "SMS Admin",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [-1536, 640],

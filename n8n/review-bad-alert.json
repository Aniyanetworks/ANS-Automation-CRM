      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $('Get Unalerted Bad Reviews').item.json;\nconst campaign = $json;\nconst submittedDate = lead.submitted_at\n  ? new Date(lead.submitted_at).toLocaleString('en-CA', { timeZone: 'America/Toronto' })\n  : 'Unknown';\n\nconst smsAlert = `âš ï¸ BAD REVIEW ALERT\\nCampaign: ${campaign.name || '?'}\\nFrom: ${lead.name || lead.phone || lead.email || 'Unknown'}\\nComment: ${lead.review_comment || '(no comment)'}\\nReceived: ${submittedDate}`;\n\nconst emailBody = `BAD REVIEW RECEIVED\\n\\nCampaign: ${campaign.name || '?'}\\nCustomer: ${lead.name || 'Unknown'}\\nPhone:    ${lead.phone || 'â€”'}\\nEmail:    ${lead.email || 'â€”'}\\nRating:   Bad\\nComment:  ${lead.review_comment || '(no comment)'}\\nReceived: ${submittedDate}\\n\\nPlease follow up with this customer as soon as possible.`;\n\nreturn {\n  ...lead,\n  campaignName: campaign.name || '?',\n  adminPhone: campaign.admin_phone || '',\n  adminEmail: campaign.admin_email || '',\n  smsAlert,\n  emailBody,\n  emailSubject: `âš ï¸ Bad Review â€” ${lead.name || lead.email || 'Customer'} (${campaign.name || 'Review Campaign'})`,\n};"
      },

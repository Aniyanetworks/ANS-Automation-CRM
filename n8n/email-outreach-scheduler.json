    {
      "parameters": {
        "jsCode": "// Works whether Get Due Leads returns the array wrapped in one item's json,\n// or split into one item per row. Emits every due lead as its own item.\nconst out = [];\nfor (const it of $input.all()) {\n  const v = it.json;\n  if (Array.isArray(v)) { for (const c of v) out.push({ json: c }); }\n  else if (v && (v.id || v.email)) { out.push({ json: v }); }\n}\nreturn out;"
      },
      "id": "a1b2c3d4-0005-4a05-9005-000000000005",
      "name": "Split Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1760,
        848
      ]
    },
    {
      "parameters": {
        "jsCode": "const steps = $('Get All Steps').all().map(i => i.json);\nconst campaigns = $('Get Campaigns').all().map(i => i.json);\nconst sentToday = $('Get Sent Today').all().map(i => i.json);\nconst now = new Date();\nconst weekday = $now.weekday; // Luxon: 1=Mon .. 7=Sun (workflow timezone)\nconst hour = $now.hour;\n// Remaining daily capacity per campaign (limit minus already-sent-today).\nconst capacity = {};\nfor (const c of campaigns) {\n  const used = sentToday.filter(s => (s.email_leads ? s.email_leads.campaign_id : s.campaign_id) === c.id).length;\n  const limit = c.daily_limit == null ? 999999 : Number(c.daily_limit);\n  capacity[c.id] = Math.max(0, limit - used);\n}\nconst dayAllowed = (c) => String(c.send_days == null ? '1,2,3,4,5,6,7' : c.send_days).split(',').map(x => parseInt(x.trim(), 10)).includes(weekday);\nconst windowOpen = (c) => {\n  const s = c.send_start_hour == null ? 0 : Number(c.send_start_hour);\n  const e = c.send_end_hour == null ? 24 : Number(c.send_end_hour);\n  return hour >= s && hour < e;\n};\nconst fill = (t, lead) => (t || '').split('{{name}}').join(lead.name || 'there').split('{{email}}').join(lead.email || '').split('{{service}}').join(lead.service || '');\nconst items = $input.all();\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const lead = items[i].json;\n  const pair = { item: i };\n  const campaign = campaigns.find(c => c.id === lead.campaign_id);\n  const base = { ...lead, lead_id: lead.id, nowISO: now.toISOString(), shouldSend: false, markComplete: false };\n  if (!campaign) { out.push({ json: base, pairedItem: pair }); continue; }\n  const curr = lead.current_step == null ? 0 : Number(lead.current_step);\n  const step = steps.find(s => s.campaign_id === lead.campaign_id && Number(s.step_number) === curr);\n  if (!step) { out.push({ json: { ...base, markComplete: true }, pairedItem: pair }); continue; }\n  const hasContent = String(step.subject || '').trim() !== '' || String(step.body || '').trim() !== '';\n  if (!hasContent) { out.push({ json: base, pairedItem: pair }); continue; }\n  // Schedule gating: only send on allowed days, within the window, and under the daily cap.\n  if (!dayAllowed(campaign) || !windowOpen(campaign)) { out.push({ json: base, pairedItem: pair }); continue; }\n  if ((capacity[campaign.id] || 0) <= 0) { out.push({ json: base, pairedItem: pair }); continue; }\n  capacity[campaign.id] -= 1;\n  const next = steps.find(s => s.campaign_id === lead.campaign_id && Number(s.step_number) === curr + 1);\n  const unitMs = { minutes: 60000, hours: 3600000, days: 86400000 };\n  let nextSendAt, newStatus;\n  if (next) { nextSendAt = new Date(now.getTime() + (Number(next.delay_days) || 0) * (unitMs[next.delay_unit] || 86400000)).toISOString(); newStatus = 'Active'; }\n  else { nextSendAt = now.toISOString(); newStatus = 'Completed'; }\n  out.push({ json: {\n    ...lead, shouldSend: true, markComplete: false, lead_id: lead.id,\n    to: lead.email, toName: lead.name, fromName: campaign.from_name || '',\n    subject: fill(step.subject, lead), body: fill(step.body, lead),\n    step_number: curr, nextStep: curr + 1, nextSendAt, newStatus,\n    emailsSent: (Number(lead.emails_sent) || 0) + 1, nowISO: now.toISOString()\n  }, pairedItem: pair });\n}\nreturn out;"
      },

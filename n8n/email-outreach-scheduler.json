    {
      "parameters": {
        "jsCode": "const leads = $input.first().json;\nif (!Array.isArray(leads)) return [{ json: leads }];\nif (leads.length === 0) return [];\nreturn leads.map(l => ({ json: l }));"
      },
      "id": "a1b2c3d4-0005-4a05-9005-000000000005",
      "name": "Split Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1760,
        848
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $json;\nconst steps = $('Get All Steps').all().map(i => i.json);\nconst campaigns = $('Get Campaigns').all().map(i => i.json);\nconst campaign = campaigns.find(c => c.id === lead.campaign_id);\nconst now = new Date();\nconst base = { ...lead, lead_id: lead.id, nowISO: now.toISOString(), shouldSend: false, markComplete: false };\n// Campaign is paused or not found -> do nothing (no send, no complete).\nif (!campaign) { return base; }\nconst curr = lead.current_step == null ? 0 : Number(lead.current_step);\nconst step = steps.find(s => s.campaign_id === lead.campaign_id && Number(s.step_number) === curr);\n// No step at this index -> the sequence is finished.\nif (!step) { return { ...base, markComplete: true }; }\n// Step exists but has no content yet -> skip without advancing (will retry next tick once filled).\nconst hasContent = String(step.subject || '').trim() !== '' || String(step.body || '').trim() !== '';\nif (!hasContent) { return base; }\nconst fill = (t) => (t || '')\n  .split('{{name}}').join(lead.name || 'there')\n  .split('{{email}}').join(lead.email || '')\n  .split('{{service}}').join(lead.service || '');\nconst next = steps.find(s => s.campaign_id === lead.campaign_id && Number(s.step_number) === curr + 1);\nlet nextSendAt, newStatus;\nif (next) {\n  nextSendAt = new Date(now.getTime() + (Number(next.delay_days) || 0) * 86400000).toISOString();\n  newStatus = 'Active';\n} else {\n  nextSendAt = now.toISOString();\n  newStatus = 'Completed';\n}\nreturn {\n  ...lead,\n  shouldSend: true,\n  markComplete: false,\n  lead_id: lead.id,\n  to: lead.email,\n  toName: lead.name,\n  fromName: campaign.from_name || '',\n  subject: fill(step.subject),\n  body: fill(step.body),\n  step_number: curr,\n  nextStep: curr + 1,\n  nextSendAt,\n  newStatus,\n  emailsSent: (Number(lead.emails_sent) || 0) + 1,\n  nowISO: now.toISOString()\n};"
      },

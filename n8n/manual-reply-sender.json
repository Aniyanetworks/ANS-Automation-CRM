    {
      "parameters": {
        "jsCode": "const b = $('Manual Reply Webhook').first().json.body || {};\nlet mid = '';\nfor (const it of $input.all()) {\n  const v = it.json;\n  if (Array.isArray(v)) { if (v[0] && v[0].message_id) mid = v[0].message_id; }\n  else if (v && v.message_id) mid = v.message_id;\n}\nmid = mid || b.messageId || '';\nreturn [{ json: { kind: b.kind, id: b.id, to: b.to, subject: b.subject, body: b.body, messageId: mid } }];"
      },

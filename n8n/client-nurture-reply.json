    {
      "parameters": {
        "jsCode": "// One output item per matched reply, so a batch of replies arriving in a single\n// poll are ALL processed (previously only the first lead was kept). pairedItem is\n// preserved so downstream $('...').item lookups resolve to the right reply.\nconst out = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const v = items[i].json;\n  let row = null;\n  if (Array.isArray(v)) { if (v.length) row = v[0]; }\n  else if (v && (v.id || v.email)) row = v;\n  if (row) out.push({ json: row, pairedItem: items[i].pairedItem != null ? items[i].pairedItem : { item: i } });\n}\nreturn out;"
      },

    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst strip = (h) => String(h || '').replace(/<[^>]+>/g, ' ').replace(/&nbsp;/gi, ' ').replace(/&amp;/gi, '&').replace(/\\s+/g, ' ').trim();\nconst byKey = new Map();\nfor (const it of items) {\n  const v = it.json;\n  const rows = Array.isArray(v) ? v : [v];\n  for (const m of rows) {\n    if (!m || !m.direction) continue;\n    const k = m.client_id || '__none__';\n    let arr = byKey.get(k); if (!arr) { arr = []; byKey.set(k, arr); }\n    arr.push(m);\n  }\n}\nconst people = $('Pick Client').all().map(i => i.json);\nconst camps = $('Get Campaign').all().map(i => i.json);\nconst replies = $('Extract Reply').all().map(i => i.json);\nconst norm = s => String(s || '').toLowerCase();\nconst out = [];\nlet idx = 0;\nfor (const [key, msgs] of byKey) {\n  const p = people.find(x => x && x.id === key) || {};\n  const camp = camps.find(c => c && c.id === p.campaign_id) || {};\n  const reply = replies.find(r => r && norm(r.fromEmail) === norm(p.email)) || {};\n  msgs.sort((a, b) => new Date(a.created_at || 0) - new Date(b.created_at || 0));\n  const transcript = msgs.map(m => (m.direction === 'inbound' ? 'Client' : 'Us') + ': ' + strip(m.body)).filter(Boolean).join(String.fromCharCode(10)) || '(no prior messages)';\n  out.push({ json: { transcript, name: p.name || '', email: p.email || '', client_id: (p.id || key), note: (p.note || '(none)'), tone: (camp.ai_reply_prompt || ''), latest: reply.body || '', subject: reply.subject || '', messageId: reply.messageId || p.message_id || '' }, pairedItem: { item: idx++ } });\n}\nif (out.length === 0) out.push({ json: { transcript: '(no prior messages)', name: '', email: '', tone: '', latest: '', subject: '', messageId: '' }, pairedItem: { item: 0 } });\nreturn out;"
      },

    {
      "parameters": {
        "jsCode": "// Normalise — n8n may wrap array in one item or split per row\nconst out = [];\nfor (const it of $input.all()) {\n  const v = it.json;\n  if (Array.isArray(v)) { for (const c of v) out.push({ json: c }); }\n  else if (v && v.id) { out.push({ json: v }); }\n}\nreturn out;"
      },
      "id": "r1e2v3i4-0004-4r04-9r04-000000000004",
      "name": "Split Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1984, 848]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Follow-up schedule: step 0 = immediate (enrollment), steps 1..N = followup_days from DB.\n// Both the schedule and message templates are fully dynamic per campaign.\nconst APP_URL = 'https://YOUR_APP_URL'; // ← replace with your deployed app URL\n\nconst lead = $json;\nconst campaigns = $('Get Active Campaigns').all().map(i => i.json);\nconst campaign = (Array.isArray(campaigns[0]) ? campaigns[0] : campaigns)\n  .find(c => c.id === lead.campaign_id);\n\nconst base = { ...lead, lead_id: lead.id, shouldSend: false, markComplete: false };\nif (!campaign) return base;\n\n// Build schedule from DB: [0, day1, day3, day7, ...]\nconst followupDays = Array.isArray(campaign.followup_days) && campaign.followup_days.length > 0\n  ? campaign.followup_days\n  : [1, 3, 7, 15, 30, 60];\nconst SCHEDULE_DAYS = [0, ...followupDays];\n\nconst step = Number(lead.current_step ?? 0);\nconst reviewLink = `${APP_URL}/r/${lead.token}`;\nconst name = lead.name || 'there';\nconst fromName = campaign.from_name || 'Aniya Network Solutions';\n\nconst fill = t => (t || '')\n  .split('{{name}}').join(name)\n  .split('{{review_link}}').join(reviewLink)\n  .split('{{from_name}}').join(fromName);\n\n// Per-step messages — fall back to campaign-level defaults if not set\nconst stepMsgs = Array.isArray(campaign.followup_messages) ? campaign.followup_messages : [];\nconst stepMsg = stepMsgs[step] || {};\nconst smsBody = fill(stepMsg.sms || campaign.sms_body || '');\nconst emailSubject = fill(stepMsg.subject || campaign.email_subject || '');\nconst emailBody = fill(stepMsg.body || campaign.email_body || '');\n\nconst nextStep = step + 1;\nconst now = new Date();\nlet nextSendAt, newStatus;\n\nif (nextStep < SCHEDULE_DAYS.length) {\n  const gapDays = SCHEDULE_DAYS[nextStep] - SCHEDULE_DAYS[step];\n  const d = new Date(now.getTime() + gapDays * 86400000);\n  nextSendAt = d.toISOString();\n  newStatus = 'Active';\n} else {\n  nextSendAt = now.toISOString();\n  newStatus = 'Completed';\n}\n\nreturn {\n  ...lead,\n  lead_id: lead.id,\n  shouldSend: true,\n  markComplete: false,\n  smsBody,\n  emailSubject,\n  emailBody,\n  reviewLink,\n  toPhone: lead.phone,\n  toEmail: lead.email,\n  toName: name,\n  fromEmail: campaign.from_email || '',\n  step,\n  nextStep,\n  nextSendAt,\n  newStatus,\n  messagesSent: (Number(lead.messages_sent) || 0) + 1,\n  nowISO: now.toISOString(),\n};"
      },
